# Copy to .env and fill in. Everything defaults to a safe DRY RUN: nothing is emailed,
# charged, or changed on anyone's site until CE_MODE=live AND the matching auto_* flag is on.

CE_MODE=dry_run                      # dry_run | live
CE_DATABASE_PATH=./data/engine.db
CE_WORKDIR=./data

# --- Who you are (required by CAN-SPAM on every commercial email) ---
CE_COMPANY__NAME=Your Company
CE_COMPANY__LEGAL_NAME=Your Company LLC
CE_COMPANY__POSTAL_ADDRESS=123 Main St, Suite 4, Springfield, IL 62701
CE_COMPANY__WEBSITE=https://yourcompany.example
CE_COMPANY__FROM_NAME=Alex at Your Company
CE_COMPANY__FROM_EMAIL=alex@outreach.yourcompany.example
CE_COMPANY__REPLY_DOMAIN=outreach.yourcompany.example
# Replies return to "<local part>+<thread token>@<reply domain>". Leave as "reply" with a
# catch-all on a real sending domain; set it to your own local part to test via Gmail.
CE_COMPANY__REPLY_LOCAL_PART=reply
CE_COMPANY__SUPPORT_EMAIL=support@yourcompany.example
CE_COMPANY__SIGNER_NAME=Alex Theriault

# --- Pricing (USD cents) ---
CE_PRICING__ADA_CENTS=149000
CE_PRICING__AISEO_CENTS=99000
CE_PRICING__BUNDLE_CENTS=199000
CE_PRICING__FLOOR_CENTS=99000        # negotiation agent may never go below this
CE_PRICING__MAX_DISCOUNT_PCT=20

# --- Autonomy switches (all off by default; turn on one at a time as each stage proves out) ---
CE_AUTONOMY__AUTO_SEND_OUTREACH=false
CE_AUTONOMY__AUTO_REPLY=false
CE_AUTONOMY__AUTO_SEND_CHECKOUT=false
CE_AUTONOMY__AUTO_APPLY_FIXES=false

# --- Sending limits / circuit breakers ---
CE_OUTREACH__DAILY_SEND_CAP=40
CE_OUTREACH__FOLLOWUP_DAYS=[3,7]
CE_OUTREACH__SEND_WINDOW_START_HOUR=9
CE_OUTREACH__SEND_WINDOW_END_HOUR=17
CE_OUTREACH__TIMEZONE=America/New_York
CE_OUTREACH__MAX_BOUNCE_RATE=0.05
CE_OUTREACH__MAX_COMPLAINT_RATE=0.002

# --- LLM ---
# claude_code = bill against your Claude subscription by driving the Claude Code CLI
#               headlessly (run `claude` once to sign in; no API key needed).
# claude      = Anthropic API with a metered ANTHROPIC_API_KEY.
# fake        = deterministic stand-in, no model calls at all.
CE_LLM__PROVIDER=claude_code
CE_LLM__MODEL=claude-opus-5
CE_LLM__CLASSIFY_MODEL=claude-sonnet-5   # reply triage is small; a cheaper model saves your quota
CE_LLM__EFFORT=medium
CE_LLM__CLAUDE_BINARY=claude
CE_LLM__MAX_BUDGET_USD=1.0               # per call, a stop-loss against a runaway prompt
ANTHROPIC_API_KEY=                       # only for CE_LLM__PROVIDER=claude

# --- Autopilot: how hard it tries before involving you (see README) ---
CE_AUTOPILOT__ENABLED=true
CE_AUTOPILOT__LINT_REPAIR_ATTEMPTS=2
CE_AUTOPILOT__CLARIFY_ATTEMPTS=1
CE_AUTOPILOT__AUTO_REFUND_AFTER_DAYS=45   # when a refund is *proposed*; you always approve it
CE_AUTOPILOT__CAPACITY_BACKOFF_MINUTES=60

# --- Risk controls (read the README's legal section before changing any of these) ---
# Self-test rail: while this list is non-empty, mail can reach nobody else. Set it to your
# own address to try the whole pipeline live and safely. See TESTING.md.
# CE_LEGAL__ONLY_EMAIL_ADDRESSES=["you+prospect@gmail.com"]
CE_LEGAL__US_ONLY=true                   # CASL/GDPR consent regimes are not implemented
CE_LEGAL__RESPECT_ROBOTS=true
CE_LEGAL__CRAWL_DELAY_SECONDS=2.0
CE_LEGAL__SNAPSHOT_RETENTION_DAYS=90
CE_LEGAL__DELETE_CREDENTIALS_AFTER_DELIVERY=true
CE_LEGAL__GOVERNING_LAW_STATE=Delaware
# Live mode stays blocked until these are honestly true. Do not set them to skip the check.
CE_LEGAL__BUSINESS_ENTITY_FORMED=false
CE_LEGAL__AGREEMENT_REVIEWED_BY_LAWYER=false
CE_LEGAL__LIABILITY_INSURANCE=false

# Encrypts client site credentials at rest. Required before live mode. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CE_SECRETS_KEY=

# --- Email transport (last step; leave provider=console until your domain is warmed up) ---
CE_EMAIL__PROVIDER=console            # console | smtp
CE_EMAIL__SMTP_HOST=
CE_EMAIL__SMTP_PORT=587
CE_EMAIL__SMTP_USER=
CE_EMAIL__SMTP_PASSWORD=
CE_EMAIL__IMAP_HOST=
CE_EMAIL__IMAP_USER=
CE_EMAIL__IMAP_PASSWORD=
CE_EMAIL__DOMAIN_VERIFIED=false       # set true only after SPF, DKIM, DMARC pass

# --- Payments ---
CE_STRIPE__SECRET_KEY=
CE_STRIPE__WEBHOOK_SECRET=
CE_STRIPE__PUBLIC_BASE_URL=https://yourcompany.example

# --- Prospecting ---
CE_PROSPECTING__GOOGLE_PLACES_KEY=
CE_PROSPECTING__OVERPASS_URL=https://overpass-api.de/api/interpreter

# --- Dashboard ---
CE_DASHBOARD__HOST=127.0.0.1
CE_DASHBOARD__PORT=8787
CE_DASHBOARD__ADMIN_TOKEN=change-me

# --- Scanning ---
CE_SCANNING__CHROMIUM_PATH=
CE_SCANNING__MAX_PAGES_PER_SITE=4
